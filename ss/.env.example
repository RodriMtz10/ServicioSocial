# Copia este archivo a ".env" y llena los valores. NUNCA subas ".env" a git.
# (Prisma y Next leen ".env"; ".env.local" NO lo lee la CLI de Prisma.)

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="postgresql://sgc:sgc_dev_password@localhost:5432/sgc?schema=public"

# URL pública de la app y secreto para firmar las sesiones.
# Genera el secreto con:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Registro de cuentas desde el login: la persona escribe su correo institucional y recibe un código de 6 dígitos para verificarlo.
# REGISTRO_ABIERTO="false" apaga el registro por completo. REGISTRO_DOMINIOS limita los correos permitidos (vacío = cualquiera).
REGISTRO_ABIERTO="true"
REGISTRO_DOMINIOS="morelia.tecnm.mx"

# Envío de correos (SMTP). Si SMTP_HOST queda vacío, en desarrollo el código aparece en la terminal de "npm run dev".
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tucuenta@gmail.com y SMTP_PASS=<contraseña de aplicación de 16 letras>.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Acciones Correctivas ITM <tucuenta@gmail.com>"

# Carpeta donde se guardan los archivos de evidencia (por defecto ./storage/evidencias). En producción usa un disco con respaldo.
ALMACEN_DIR=""
# Respaldos (npm run respaldo): carpeta y cuántos se conservan.
RESPALDOS_DIR=""
RESPALDOS_CONSERVAR="14"

# Recordatorios de acciones vencidas por correo.
# CRON_SECRET (mínimo 16 caracteres) permite que una tarea programada llame a POST /api/recordatorios con «Authorization: Bearer <CRON_SECRET>»
# (o ejecuta «npm run recordatorios»). RECORDATORIO_DIAS = cada cuántos días se repite el aviso de la misma requisición.
CRON_SECRET=""
RECORDATORIO_DIAS="3"
